@page
@model IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "GrabLog Kiosk";
}

<div class="container py-5">
    <div class="card shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-body text-center p-4">
            <h2 class="card-title mb-3">GrabLog Kiosk Panel</h2>
            <p class="text-muted mb-4">Select an action below or scan an RFID card on the kiosk.</p>

            <!-- Kiosk Action Buttons -->
            <div class="d-flex justify-content-center gap-3 mb-3">
                <button type="button" class="btn btn-success btn-lg px-4" onclick="triggerKioskAction('BORROW')">
                    Borrow Tool
                </button>
                <button type="button" class="btn btn-danger btn-lg px-4" onclick="triggerKioskAction('RETURN')">
                    Return Tool
                </button>
            </div>

            <!-- Status Notification Area -->
            <div id="statusMessage" class="alert mt-3" style="display: none;" role="alert"></div>
        </div>
    </div>
</div>

<script>
async function triggerKioskAction(actionType) {
    const statusDiv = document.getElementById('statusMessage');
    
    const payload = {
        CardUID: "DEFAULT_UID",
        UserName: "Member1",
        ActionType: actionType,
        ToolId: "TOOL-01"
    };

    try {
        let response = await fetch('/api/kiosk/transaction', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        let result = await response.json();
        
        if (statusDiv) {
            statusDiv.style.display = 'block';
            if (response.ok && result.success) {
                statusDiv.className = 'alert alert-success mt-3';
                statusDiv.innerText = result.message || 'Transaction processed successfully.';
            } else {
                statusDiv.className = 'alert alert-danger mt-3';
                statusDiv.innerText = "Error: " + (result.message || "Transaction failed.");
            }
        }
    } catch (error) {
        console.error('Error:', error);
        if (statusDiv) {
            statusDiv.style.display = 'block';
            statusDiv.className = 'alert alert-danger mt-3';
            statusDiv.innerText = "Network error connecting to server.";
        }
    }
}
</script>
