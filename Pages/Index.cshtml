@page
@model IndexModel
@{
    ViewData["Title"] = "GrabLog Kiosk";
}

<!-- Your Original Page Content / Layout Container -->
<div class="container mt-4">
    <div class="row">
        <div class="col-12 text-center">
            <h1>GrabLog Kiosk Panel</h1>
            <p class="text-muted">Select an action or scan your RFID card.</p>

            <!-- Kiosk Action Buttons -->
            <div class="my-4">
                <button type="button" class="btn btn-success btn-lg mx-2" onclick="triggerKioskAction('BORROW')">
                    Borrow Tool
                </button>
                <button type="button" class="btn btn-danger btn-lg mx-2" onclick="triggerKioskAction('RETURN')">
                    Return Tool
                </button>
            </div>

            <!-- Status message container -->
            <div id="statusMessage" class="alert mt-3" style="display: none;" role="alert"></div>
        </div>
    </div>
</div>

<!-- JavaScript to stop page reloads and send requests in the background -->
<script>
async function triggerKioskAction(actionType) {
    const statusDiv = document.getElementById('statusMessage');
    
    const payload = {
        CardUID: "DEFAULT_UID",
        UserName: "Member1",
        ActionType: actionType,
        ToolId: "TOOL-01"
    };

    try {
        let response = await fetch('/api/kiosk/transaction', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        let result = await response.json();
        
        if (statusDiv) {
            statusDiv.style.display = 'block';
            if (response.ok && result.success) {
                statusDiv.className = 'alert alert-success mt-3';
                statusDiv.innerText = result.message || 'Transaction processed successfully.';
            } else {
                statusDiv.className = 'alert alert-danger mt-3';
                statusDiv.innerText = "Error: " + (result.message || "Transaction failed.");
            }
        }
    } catch (error) {
        console.error('Error:', error);
        if (statusDiv) {
            statusDiv.style.display = 'block';
            statusDiv.className = 'alert alert-danger mt-3';
            statusDiv.innerText = "Network error connecting to server.";
        }
    }
}
</script>
