@page
@model IndexModel
@{
    ViewData["Title"] = "Kiosk Dashboard";
}

<div class="text-center px-4 py-5">
    <h1 class="display-4 fw-bold">GrabLog Kiosk Panel</h1>
    <p class="lead text-muted">Select an action below or scan your RFID card on the kiosk.</p>

    <!-- Kiosk Action Buttons -->
    <div class="mt-4">
        <button type="button" class="btn btn-success btn-lg px-5 py-3 mx-2 fw-bold" onclick="triggerKioskAction('BORROW')">
            Borrow Tool
        </button>
        <button type="button" class="btn btn-danger btn-lg px-5 py-3 mx-2 fw-bold" onclick="triggerKioskAction('RETURN')">
            Return Tool
        </button>
    </div>

    <!-- Status Notification Area -->
    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <div id="statusMessage" class="alert" style="display: none;" role="alert"></div>
        </div>
    </div>
</div>

<script>
async function triggerKioskAction(actionType) {
    const statusDiv = document.getElementById('statusMessage');
    
    const payload = {
        CardUID: "DEFAULT_UID",
        UserName: "Member1",
        ActionType: actionType,
        ToolId: "TOOL-01"
    };

    try {
        let response = await fetch('/api/kiosk/transaction', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        let result = await response.json();
        
        if (statusDiv) {
            statusDiv.style.display = 'block';
            if (response.ok && result.success) {
                statusDiv.className = 'alert alert-success mt-3';
                statusDiv.innerText = result.message || 'Transaction processed successfully.';
            } else {
                statusDiv.className = 'alert alert-danger mt-3';
                statusDiv.innerText = "Error: " + (result.message || "Transaction failed.");
            }
        }
    } catch (error) {
        console.error('Error:', error);
        if (statusDiv) {
            statusDiv.style.display = 'block';
            statusDiv.className = 'alert alert-danger mt-3';
            statusDiv.innerText = "Network error connecting to server.";
        }
    }
}
</script>
