@page
@model NotificationsModel
@{
    ViewData["Title"] = "Notifications";
    string TypeIcon(string t) => t switch { "borrow" => "📦", "return" => "✅", "overdue" => "⚠️", "dispose" => "🗑️", "restore" => "♻️", _ => "🔔" };
    string TypeColor(string t) => t switch { "borrow" => "#ffcc00", "return" => "#22c55e", "overdue" => "#ef4444", "dispose" => "#ef4444", "restore" => "#22c55e", _ => "#8a8a8a" };
}

<div class="topbar">
  <div class="brand">
    <img src="~/logo.png" class="logo-img sm" alt="" />
    <div>
      <div style="font-weight:700;font-size:13px;">GRAB & LOG</div>
      <div style="font-size:9px;color:var(--muted);">TOOL ROOM 5.1</div>
    </div>
  </div>
  <a href="/Operators" class="user" style="text-decoration:none;color:inherit;margin-left:12px;">
    <div style="text-align:right;line-height:1.3;">
      <div style="font-weight:600;">@Model.UserName</div>
      <div style="font-size:10px;color:var(--muted);">@(Model.IsAdmin ? "ADMIN" : "MEMBER") · #@Model.OpId</div>
    </div>
    <div class="avatar">@Model.Initials</div>
  </a>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="nav-label">NAVIGATION</div>
    <a class="nav-btn" href="/Inventory">📦 Inventory</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn" href="/Registry">📋 Control Registry</a>
      <a class="nav-btn" href="/Logs">📜 Activity Logs</a>
    }
    <a class="nav-btn" href="/Alerts">🚨 Alerts Desk</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn" href="/Operators">👥 Member Registry</a>
    }
    <div class="sidebar-foot">@(Model.IsAdmin ? "ADMIN MODE" : "MEMBER MODE") · SYSTEM</div>
  </div>
  <div class="content" style="color:#f0f0f0;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div>
        <h2 style="font-size:20px;margin:0 0 4px;">Notifications</h2>
        <p style="font-size:12px;color:#8a8a8a;margin:0;">Borrow, return, and overdue alerts</p>
      </div>
      <form method="post" asp-page-handler="MarkAll">
        <button type="submit" class="btn-sm">Mark all read</button>
      </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
      <div style="background:rgba(239,68,68,0.2);border:1px solid #ef4444;border-radius:8px;padding:14px;margin-bottom:16px;color:#ef4444;">
        <strong>Error:</strong> @Model.Error
      </div>
    }

    @if (Model.Items.Count == 0)
    {
      <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:32px;text-align:center;color:#8a8a8a;">
        No notifications yet. They appear when tools are borrowed, returned, or go overdue.
      </div>
    }
    else
    {
      @foreach (var n in Model.Items)
      {
        var local = n.CreatedAt?.ToLocalTime();
        <div class="card" style="margin-bottom:10px;@(n.IsRead ? "opacity:0.7;" : "border-color:rgba(255,204,0,0.35);")">
          <div style="display:flex;gap:12px;align-items:flex-start;">
            <div style="font-size:22px;">@TypeIcon(n.Type)</div>
            <div style="flex:1;">
              <div style="font-weight:600;color:@TypeColor(n.Type);">@n.Title</div>
              <div style="font-size:13px;color:#c0c0c0;margin-top:4px;">@n.Message</div>
              <div style="font-size:11px;color:#8a8a8a;margin-top:6px;">@(local?.ToString("MMM d, yyyy · h:mm:ss tt") ?? "")</div>
            </div>
            @if (!n.IsRead && n.Id.HasValue)
            {
              <form method="post" asp-page-handler="MarkRead">
                <input type="hidden" name="id" value="@n.Id" />
                <button type="submit" class="btn-sm">Read</button>
              </form>
            }
          </div>
        </div>
      }
    }
  </div>
</div>
