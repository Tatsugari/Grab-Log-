@page
@model RegistryModel
@{
    ViewData["Title"] = "Control Registry";
    var uname = HttpContext.Session.GetString("UserName") ?? "Admin";
    var uemail = HttpContext.Session.GetString("UserEmail") ?? "";
    var initials = string.Concat(uname.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
    var opId = Math.Abs(uemail.GetHashCode()) % 100000;
}

<div class="topbar">
  <div class="brand">
    <img src="~/logo.png" class="logo-img sm" alt="" />
    <div>
      <div style="font-weight:700;font-size:13px;">GRAB & LOG</div>
      <div style="font-size:9px;color:var(--muted);">TOOL ROOM 5.1</div>
    </div>
  </div>
  <a href="/Operators" class="user" style="text-decoration:none;color:inherit;">
    <div style="text-align:right;line-height:1.3;">
      <div style="font-weight:600;">@uname</div>
      <div style="font-size:10px;color:var(--muted);">ADMIN · #@opId</div>
    </div>
    <div class="avatar">@initials</div>
  </a>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="nav-label">NAVIGATION</div>
    <a class="nav-btn" href="/Inventory">📦 Inventory</a>
    <a class="nav-btn active" href="/Registry">📋 Control Registry</a>
    <a class="nav-btn" href="/Logs">📜 Activity Logs</a>
    <a class="nav-btn" href="/Alerts">🚨 Alerts Desk</a>
    <a class="nav-btn" href="/Operators">👥 Member Registry</a>
    <div class="sidebar-foot">ADMIN MODE · SYSTEM</div>
  </div>
  <div class="content">
    @if (!string.IsNullOrEmpty(Model.Error))
    {
      <div style="background:rgba(239,68,68,0.2);border:1px solid #ef4444;border-radius:8px;padding:14px;margin-bottom:16px;color:#ef4444;">
        <strong>Error:</strong> @Model.Error
      </div>
    }
    <div style="margin-bottom:16px;">
      <h2 style="font-size:20px;">Control Registry</h2>
      <p style="font-size:12px;color:var(--muted);">Manage tools — borrow, return, dispose, restore.</p>
    </div>
    <div class="stats">
      <div class="stat"><div class="num">@Model.Total</div><div class="lbl">TOTAL</div></div>
      <div class="stat"><div class="num">@Model.InUse</div><div class="lbl">IN USE</div></div>
      <div class="stat danger"><div class="num">@Model.OverdueCount</div><div class="lbl">OVERDUE</div></div>
      <div class="stat"><div class="num">@Model.Disposed</div><div class="lbl">DISPOSED</div></div>
    </div>
    @if (Model.Tools.Count == 0)
    {
      <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:32px;text-align:center;color:#8a8a8a;">No tools loaded.</div>
    }
    else
    {
      <div class="cards">
        @foreach (var t in Model.Tools)
        {
          <div class="card">
            <div class="card-top">
              <div>
                <div class="card-id">@t.Id</div>
                <div class="card-name">@t.Name</div>
              </div>
              <div class="card-icon">@t.Icon</div>
            </div>
            <span class="badge @t.Status">@t.Status.ToUpper()</span>
            <div class="card-meta">@t.Location @if(!string.IsNullOrEmpty(t.LoggedTo)){<text>· @t.LoggedTo</text>}</div>
            <div style="display:flex;gap:6px;flex-wrap:wrap;">
              @if (t.Status == "available")
              {
                <form method="post" asp-page-handler="Borrow"><input type="hidden" name="id" value="@t.Id" /><button class="btn-borrow" style="width:auto;padding:7px 12px;">Borrow</button></form>
                <form method="post" asp-page-handler="Dispose"><input type="hidden" name="id" value="@t.Id" /><button class="btn-dispose" type="submit">Dispose</button></form>
              }
              @if (t.Status == "inuse" || t.Status == "overdue")
              {
                <form method="post" asp-page-handler="Return"><input type="hidden" name="id" value="@t.Id" /><button class="btn-return" style="width:auto;padding:7px 12px;background:#ef4444;color:#fff;">Return</button></form>
                <form method="post" asp-page-handler="Dispose"><input type="hidden" name="id" value="@t.Id" /><button class="btn-dispose" type="submit">Dispose</button></form>
              }
              @if (t.Status == "disposed")
              {
                <form method="post" asp-page-handler="Restore"><input type="hidden" name="id" value="@t.Id" /><button class="btn-borrow" style="width:auto;padding:7px 12px;">Restore</button></form>
              }
            </div>
          </div>
        }
      </div>
    }
  </div>
</div>
