@page
@model LogsModel
@{
    ViewData["Title"] = "Activity Logs";
}

<div class="topbar">
  <div class="brand">
    <img src="~/logo.png" class="logo-img sm" alt="" />
    <div>
      <div style="font-weight:700;font-size:13px;">GRAB & LOG</div>
      <div style="font-size:9px;color:var(--muted);">TOOL ROOM 5.1</div>
    </div>
  </div>
  <a href="/Operators" class="user" style="text-decoration:none;color:inherit;">
    <div style="text-align:right;line-height:1.3;">
      <div style="font-weight:600;">@Model.UserName</div>
      <div style="font-size:10px;color:var(--muted);">ADMIN · #@Model.OpId</div>
    </div>
    <div class="avatar">@Model.Initials</div>
  </a>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="nav-label">NAVIGATION</div>
    <a class="nav-btn" href="/Inventory">📦 Inventory</a>
    <a class="nav-btn" href="/Registry">📋 Control Registry</a>
    <a class="nav-btn active" href="/Logs">📜 Activity Logs</a>
    <a class="nav-btn" href="/Alerts">🚨 Alerts Desk</a>
    <a class="nav-btn" href="/Operators">👥 Member Registry</a>
    <div class="sidebar-foot">ADMIN MODE · SYSTEM</div>
  </div>

  <div class="content" style="color:#f0f0f0;">
    <div style="margin-bottom:16px;">
      <h2 style="font-size:20px;margin:0 0 6px;color:#f0f0f0;">Activity Logs</h2>
      <p style="font-size:12px;color:#8a8a8a;margin:0;">
        History of borrow, return, dispose, restore, overdue. Times are Philippines (PHT, UTC+8). Logs older than 1 week are removed automatically.
      </p>
    </div>

    <form method="get" style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px;align-items:center;">
      @if (!string.IsNullOrEmpty(Model.ToolFilter))
      {
        <input type="hidden" name="tool" value="@Model.ToolFilter" />
      }
      <select name="category" style="background:#0f0f0f;border:1px solid #2a2a2a;border-radius:7px;padding:10px 12px;color:#f0f0f0;font-size:13px;">
        @if (Model.Category == "all") { <option value="all" selected>All fields</option> } else { <option value="all">All fields</option> }
        @if (Model.Category == "name") { <option value="name" selected>Name</option> } else { <option value="name">Name</option> }
        @if (Model.Category == "id") { <option value="id" selected>ID number / RFID</option> } else { <option value="id">ID number / RFID</option> }
        @if (Model.Category == "date") { <option value="date" selected>Date</option> } else { <option value="date">Date</option> }
        @if (Model.Category == "week") { <option value="week" selected>Week</option> } else { <option value="week">Week</option> }
        @if (Model.Category == "time") { <option value="time" selected>Time</option> } else { <option value="time">Time</option> }
        @if (Model.Category == "tools") { <option value="tools" selected>Tools</option> } else { <option value="tools">Tools</option> }
      </select>
      <input type="text" name="q" value="@Model.Q" placeholder="Search…"
             style="flex:1;min-width:180px;background:#0f0f0f;border:1px solid #2a2a2a;border-radius:7px;padding:10px 12px;color:#f0f0f0;font-size:13px;" />
      <button type="submit" style="background:#ffcc00;color:#111;border:none;border-radius:7px;padding:10px 16px;font-weight:600;cursor:pointer;">Search</button>
      <a href="/Logs" style="color:#8a8a8a;font-size:12px;text-decoration:none;">Clear</a>
    </form>
    <div style="font-size:11px;color:#8a8a8a;margin-bottom:14px;">
      Tips: Week → type <strong>this</strong> or <strong>last</strong>. Date → <strong>2026-10-19</strong>. Time → <strong>2:30</strong> or <strong>PM</strong>.
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
      <div style="background:rgba(239,68,68,0.2);border:1px solid #ef4444;border-radius:8px;padding:14px;margin-bottom:16px;color:#ef4444;">
        <strong>Error:</strong> @Model.Error
      </div>
    }

    <div style="margin-bottom:12px;font-size:12px;color:#8a8a8a;">
      Showing <strong style="color:#f0f0f0;">@(Model.Entries?.Count ?? 0)</strong> entries
    </div>

    @if (Model.Entries == null || Model.Entries.Count == 0)
    {
      <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:32px;text-align:center;color:#8a8a8a;">
        No log entries match.
      </div>
    }
    else
    {
      <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;overflow:auto;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="border-bottom:1px solid #2a2a2a;">
              <th style="text-align:left;padding:12px 14px;font-size:10px;color:#8a8a8a;letter-spacing:0.5px;">DATE / TIME</th>
              <th style="text-align:left;padding:12px 14px;font-size:10px;color:#8a8a8a;letter-spacing:0.5px;">ACTION</th>
              <th style="text-align:left;padding:12px 14px;font-size:10px;color:#8a8a8a;letter-spacing:0.5px;">TOOL</th>
              <th style="text-align:left;padding:12px 14px;font-size:10px;color:#8a8a8a;letter-spacing:0.5px;">USER</th>
              <th style="text-align:left;padding:12px 14px;font-size:10px;color:#8a8a8a;letter-spacing:0.5px;">DETAILS</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var e in Model.Entries)
            {
              var local = e.CreatedAt.HasValue ? GrabLog.Services.PhTime.ToPhilippines(e.CreatedAt.Value) : (DateTime?)null;
              var actionColor = e.Action switch
              {
                  "borrow" => "#ffcc00",
                  "return" => "#22c55e",
                  "dispose" => "#ef4444",
                  "restore" => "#22c55e",
                  "overdue" => "#ef4444",
                  _ => "#8a8a8a"
              };
              <tr style="border-bottom:1px solid #2a2a2a;">
                <td style="padding:12px 14px;font-size:12px;white-space:nowrap;color:#f0f0f0;">
                  @if (local.HasValue)
                  {
                    <div>@local.Value.ToString("MMM d, yyyy")</div>
                    <div style="color:#8a8a8a;font-size:11px;">@local.Value.ToString("h:mm:ss tt") PHT</div>
                  }
                  else
                  {
                    <span style="color:#8a8a8a;">—</span>
                  }
                </td>
                <td style="padding:12px 14px;">
                  <span style="font-size:10px;font-weight:700;letter-spacing:0.5px;color:@actionColor;">@(e.Action?.ToUpper() ?? "—")</span>
                </td>
                <td style="padding:12px 14px;font-size:12px;color:#f0f0f0;">
                  <strong>@e.ToolName</strong>
                  <span style="color:#8a8a8a;font-size:11px;"> (@e.ToolId)</span>
                </td>
                <td style="padding:12px 14px;font-size:12px;color:#f0f0f0;">@e.UserName</td>
                <td style="padding:12px 14px;font-size:12px;color:#8a8a8a;">@e.Details</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    }
  </div>
</div>
