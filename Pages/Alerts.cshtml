@page
@model AlertsModel
@{
    ViewData["Title"] = "Alerts Desk";
}

<div class="topbar">
  <div class="brand">
    <img src="~/logo.png" class="logo-img sm" alt="" />
    <div>
      <div style="font-weight:700;font-size:13px;">GRAB & LOG</div>
      <div style="font-size:9px;color:var(--muted);">TOOL ROOM 5.1</div>
    </div>
  </div>
  <a href="/Operators" class="user" style="text-decoration:none;color:inherit;">
    <div style="text-align:right;line-height:1.3;">
      <div style="font-weight:600;">@Model.UserName</div>
      <div style="font-size:10px;color:var(--muted);">@(Model.IsAdmin ? "ADMIN" : "MEMBER") · #@Model.OpId</div>
    </div>
    <div class="avatar">@Model.Initials</div>
  </a>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="nav-label">NAVIGATION</div>
    <a class="nav-btn" href="/Inventory">📦 Inventory</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn" href="/Registry">📋 Control Registry</a>
      <a class="nav-btn" href="/Logs">📜 Activity Logs</a>
    }
    <a class="nav-btn active" href="/Alerts">🚨 Alerts Desk</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn" href="/Operators">👥 Member Registry</a>
    }
    <div class="sidebar-foot">@(Model.IsAdmin ? "ADMIN MODE" : "MEMBER MODE") · SYSTEM</div>
  </div>
  <div class="content">
    <div style="margin-bottom:16px;">
      <h2 style="font-size:20px;color:#f0f0f0;">Alerts Desk</h2>
      <p style="font-size:12px;color:#8a8a8a;">Overdue tools (past 9h shift).</p>
    </div>
    @if (Model.Overdue == null || Model.Overdue.Count == 0)
    {
      <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:32px;text-align:center;color:#8a8a8a;">
        No active alerts. System clear.
      </div>
    }
    else
    {
      @foreach (var t in Model.Overdue)
      {
        <div class="alert-banner" style="margin-bottom:12px;">
          <div style="display:flex;align-items:center;gap:10px;">
            <span style="font-size:18px;">⚠️</span>
            <div>
              <div class="title">OVERDUE — @t.Name (@t.Id)</div>
              <div class="sub">Logged to @(t.LoggedTo ?? "unknown") · @t.Location</div>
            </div>
          </div>
          <form method="post" asp-page-handler="Return">
            <input type="hidden" name="id" value="@t.Id" />
            <button type="submit" class="btn-return" style="width:auto;padding:7px 14px;background:#ef4444;color:#fff;">Mark Returned</button>
          </form>
        </div>
      }
    }
  </div>
</div>
