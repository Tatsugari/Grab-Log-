@page
@model InventoryModel
@{
    ViewData["Title"] = "Inventory";
    var name = Model.UserName;
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
}

<div class="topbar">
  <div class="brand">
    <img src="~/logo.png" class="logo-img sm" alt="" />
    <div>
      <div style="font-weight:700;font-size:13px;">GRAB & LOG</div>
      <div style="font-size:9px;color:var(--muted);">TOOL ROOM 5.1</div>
    </div>
  </div>
  <form method="get" action="/Inventory" style="flex:1;max-width:420px;margin:0 20px;display:flex;gap:8px;align-items:center;">
    <input type="hidden" name="filter" value="@Model.Filter" />
    <input class="search-input" type="text" name="q" value="@Model.Search" placeholder="Search name, ID, location, borrower…" style="flex:1;width:100%;" autocomplete="off" />
    <button type="submit" style="background:#ffcc00;color:#111;border:none;border-radius:7px;padding:8px 14px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;">Search</button>
  </form>
<div style="margin-left:auto;display:flex;align-items:center;gap:8px;">
    <button type="button" id="btn-install-app" onclick="installWebApp()" style="background:#ffcc00;border:none;color:#111;border-radius:7px;padding:8px 12px;font-size:11px;font-weight:600;cursor:pointer;">Download app</button>
    <button type="button" id="btn-enable-desktop" onclick="enableDesktopNotifs()" style="background:none;border:1px solid #2a2a2a;color:#8a8a8a;border-radius:7px;padding:8px 10px;font-size:11px;cursor:pointer;">Enable PC alerts</button>
    <a href="/Operators" class="user" style="text-decoration:none;color:inherit;margin-left:0;">
      <div style="text-align:right;line-height:1.3;">
        <div style="font-weight:600;">@name</div>
        <div style="font-size:10px;color:var(--muted);">@(Model.IsAdmin ? "ADMIN" : "MEMBER") · #@Model.OpId</div>
      </div>
      <div class="avatar">@initials</div>
    </a>
  </div>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="nav-label">NAVIGATION</div>
    <a class="nav-btn active" href="/Inventory">📦 Inventory</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn" href="/Registry">📋 Control Registry</a>
      <a class="nav-btn" href="/Logs">📜 Activity Logs</a>
    }
    <a class="nav-btn" href="/Alerts">🚨 Alerts Desk</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn" href="/Operators">👥 Member Registry</a>
    }
    <div class="sidebar-foot">@(Model.IsAdmin ? "ADMIN MODE" : "MEMBER MODE") · SYSTEM</div>
  </div>

  <div class="content">
    @if (!string.IsNullOrEmpty(Model.Error))
    {
      <div style="background:rgba(239,68,68,0.2);border:1px solid #ef4444;border-radius:8px;padding:14px;margin-bottom:16px;color:#ef4444;">
        <strong>Error:</strong> @Model.Error
      </div>
    }

    <div id="kiosk-bar" style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:12px 14px;margin-bottom:16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;">
      <div style="font-weight:600;font-size:13px;color:#ffcc00;">RFID Kiosk</div>
      <button type="button" class="btn-sm" onclick="Kiosk.connect()" style="border-color:#ffcc00;color:#ffcc00;">Connect Kiosk</button>
      <span id="kiosk-selected-tool" style="font-size:11px;color:#8a8a8a;">Connect Kiosk, then click Borrow/Return and scan RFID</span>
      <span id="kiosk-status" style="font-size:11px;color:#8a8a8a;margin-left:auto;">Not connected</span>
    </div>

    <div class="panel-top">
      <div class="tabs">
        <a class="tab @(Model.Filter=="all"?"active":"")" href="/Inventory?filter=all&q=@Model.Search">All (@Model.Total)</a>
        <a class="tab @(Model.Filter=="available"?"active":"")" href="/Inventory?filter=available&q=@Model.Search">Available (@Model.Available)</a>
        <a class="tab @(Model.Filter=="inuse"?"active":"")" href="/Inventory?filter=inuse&q=@Model.Search">In Use (@Model.InUse)</a>
        <a class="tab @(Model.Filter=="overdue"?"active":"")" href="/Inventory?filter=overdue&q=@Model.Search">Overdue (@Model.Overdue)</a>
      </div>
      <div class="online"><div class="dot"></div> SYSTEM ONLINE</div>
    </div>

    @if (Model.Tools == null || Model.Tools.Count == 0)
    {
      <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:32px;text-align:center;color:#8a8a8a;">
        No tools to show.
        @if (string.IsNullOrEmpty(Model.Error))
        {
          <div style="margin-top:8px;font-size:12px;">If this is unexpected, check Supabase tools table or try refresh.</div>
        }
      </div>
    }
    else
    {
      <div class="cards">
        @foreach (var t in Model.Tools)
        {
          <div class="card @(t.Status != "disposed" ? "accent" : "")" data-tool-id="@t.Id">
            <div class="card-top">
              <div>
                <div class="card-id">@t.Id</div>
                <div class="card-name">@t.Name</div>
              </div>
              <div class="card-icon">@t.Icon</div>
            </div>
            <span class="badge @t.Status">@t.Status.ToUpper()</span>
            <div class="card-meta">
              STORAGE LOCATION<br /><span class="val">@t.Location</span>
              @if (!string.IsNullOrEmpty(t.LoggedTo))
              {
                <br /><span style="color:var(--muted)">LOGGED: @t.LoggedTo</span>
              }
              @if (t.Status == "inuse" || t.Status == "overdue")
              {
                var hrs = GrabLog.Services.ToolService.HoursUntilOverdue(t);
                if (hrs <= 0)
                {
                  <br /><span style="color:var(--red);font-weight:600;">OVERDUE (past 9h shift)</span>
                }
                else
                {
                  <br /><span style="color:var(--muted)">Due in @hrs.ToString("0.0")h</span>
                }
              }
            </div>
            @if (t.Status == "available")
            {
              <form id="form-borrow-@t.Id" method="post" asp-page-handler="Borrow" onclick="event.stopPropagation();" style="display:none;">
                <input type="hidden" name="id" value="@t.Id" />
              </form>
              <button type="button" class="btn-borrow" onclick="event.stopPropagation(); Kiosk.requestBorrow('@t.Id')">BORROW TOOL</button>
            }
            else if (t.Status == "inuse" || t.Status == "overdue")
            {
              <form id="form-return-@t.Id" method="post" asp-page-handler="Return" onclick="event.stopPropagation();" style="display:none;">
                <input type="hidden" name="id" value="@t.Id" />
              </form>
              <button type="button" class="btn-return" style="background:#ef4444;color:#fff;" onclick="event.stopPropagation(); Kiosk.requestReturn('@t.Id')">RETURN</button>
            }
            else
            {
              <button class="btn-sm" disabled style="opacity:0.5;width:100%;">UNAVAILABLE</button>
            }
          </div>
        }
      </div>
    }
  </div>
</div>

@section Scripts {
  <script src="~/js/kiosk.js"></script>
}
