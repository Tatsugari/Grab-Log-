@page
@model OperatorsModel
@{
    ViewData["Title"] = Model.IsAdmin ? "Member Registry" : "My Profile";
    var ok = TempData["Ok"] as string;
    var err = TempData["Err"] as string;
}

<div class="topbar">
  <div class="brand">
    <img src="~/logo.png" class="logo-img sm" alt="" />
    <div>
      <div style="font-weight:700;font-size:13px;">GRAB & LOG</div>
      <div style="font-size:9px;color:var(--muted);">TOOL ROOM 5.1</div>
    </div>
  </div>
  <a href="/Operators" class="user" style="text-decoration:none;color:inherit;">
    <div style="text-align:right;line-height:1.3;">
      <div style="font-weight:600;">@Model.UserName</div>
      <div style="font-size:10px;color:var(--muted);">@(Model.IsAdmin ? "ADMIN" : "MEMBER") · #@Model.OpId</div>
    </div>
    <div class="avatar">@Model.Initials</div>
  </a>
</div>

<div class="layout">
  <div class="sidebar">
    <div class="nav-label">NAVIGATION</div>
    <a class="nav-btn" href="/Inventory">📦 Inventory</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn" href="/Registry">📋 Control Registry</a>
      <a class="nav-btn" href="/Logs">📜 Activity Logs</a>
    }
    <a class="nav-btn" href="/Alerts">🚨 Alerts Desk</a>
    @if (Model.IsAdmin)
    {
      <a class="nav-btn active" href="/Operators">👥 Member Registry</a>
    }
    <div class="sidebar-foot">@(Model.IsAdmin ? "ADMIN MODE" : "MEMBER MODE") · SYSTEM</div>
  </div>
  <div class="content">
    <div style="margin-bottom:16px;">
      <h2 style="font-size:20px;color:#f0f0f0;">@(Model.IsAdmin ? "Member Registry" : "My Profile")</h2>
      <p style="font-size:12px;color:#8a8a8a;">@(Model.IsAdmin ? "Accounts + RFID card UIDs" : "Your account")</p>
    </div>

    @if (!string.IsNullOrEmpty(ok))
    {
      <div style="background:rgba(34,197,94,0.15);border:1px solid #22c55e;border-radius:8px;padding:12px;margin-bottom:14px;color:#22c55e;">@ok</div>
    }
    @if (!string.IsNullOrEmpty(err) || !string.IsNullOrEmpty(Model.Message))
    {
      <div style="background:rgba(239,68,68,0.15);border:1px solid #ef4444;border-radius:8px;padding:12px;margin-bottom:14px;color:#ef4444;">@(err ?? Model.Message)</div>
    }

    <div class="card" style="max-width:420px;margin-bottom:16px;">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:14px;">
        <div class="avatar" style="width:40px;height:40px;font-size:14px;">@Model.Initials</div>
        <div>
          <div style="font-weight:600;font-size:15px;color:#f0f0f0;">@Model.UserName</div>
          <div style="font-size:12px;color:#8a8a8a;">@Model.UserEmail</div>
        </div>
      </div>
      <div class="card-meta">
        ROLE<br /><span class="val">@(Model.IsAdmin ? "ADMIN" : "MEMBER")</span><br /><br />
        ID<br /><span class="val">#@Model.OpId</span>
      </div>
      <form method="post" asp-page-handler="Logout">
        <button type="submit" class="btn-sm" style="width:100%;margin-top:12px;">Sign Out</button>
      </form>
    </div>

    @if (Model.IsAdmin)
    {
      <div style="font-size:13px;color:#f0f0f0;font-weight:600;margin-bottom:10px;">Members &amp; RFID cards</div>
      <p style="font-size:12px;color:#8a8a8a;margin-bottom:14px;">
        Save each person&rsquo;s RFID UID (from ESP32 scan, e.g. 6A5E8CA5).
      </p>

      @if (Model.AllMembers == null || Model.AllMembers.Count == 0)
      {
        <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:24px;color:#8a8a8a;">No members found.</div>
      }
      else
      {
        <div style="display:flex;flex-direction:column;gap:12px;max-width:560px;">
          @foreach (var m in Model.AllMembers)
          {
            <div style="background:#161616;border:1px solid #2a2a2a;border-radius:10px;padding:14px 16px;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                <div>
                  <div style="font-weight:600;color:#f0f0f0;">@m.Name</div>
                  <div style="font-size:11px;color:#8a8a8a;">@m.Email · @(m.Role?.ToUpper() ?? "MEMBER")</div>
                </div>
                <div style="font-size:11px;color:#ffcc00;font-family:monospace;">
                  @(string.IsNullOrEmpty(m.RfidUid) ? "No RFID" : m.RfidUid)
                </div>
              </div>
              <form method="post" asp-page-handler="SaveRfid" style="display:flex;gap:8px;">
                <input type="hidden" name="memberId" value="@m.Id" />
                <input type="text" name="rfidUid" value="@m.RfidUid" placeholder="RFID UID e.g. 6A5E8CA5"
                       style="flex:1;background:#0f0f0f;border:1px solid #2a2a2a;border-radius:7px;padding:9px 11px;color:#f0f0f0;font-size:13px;font-family:monospace;" />
                <button type="submit" style="background:#ffcc00;color:#111;border:none;border-radius:7px;padding:9px 14px;font-weight:600;cursor:pointer;">Save UID</button>
              </form>
            </div>
          }
        </div>
      }
    }
  </div>
</div>
